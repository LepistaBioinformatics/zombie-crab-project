+// TestResolveRoute_WildcardChatSelector is the reason the glob exists: one rule
+// covering a family of chats, instead of one rule per chat identifier.
+func TestResolveRoute_WildcardChatSelector(t *testing.T) {
+	cfg := testConfig([]config.AgentConfig{
+		{ID: "main", Default: true},
+		{ID: "seedtrial"},
+	})
+	cfg.Agents.Dispatch = &config.DispatchConfig{
+		Rules: []config.DispatchRule{{
+			Name:  "project-seedtrial",
+			Agent: "seedtrial",
+			When: config.DispatchSelector{
+				Channel: "pico",
+				Chat:    "direct:pico:p.seedtrial.*",
+			},
+		}},
+	}
+	r := NewRouteResolver(cfg)
+
+	inbound := func(chatID string) bus.InboundContext {
+		return bus.InboundContext{
+			Channel:  "pico",
+			ChatID:   chatID,
+			ChatType: "direct",
+			SenderID: "pico-user",
+		}
+	}
+
+	// Two distinct conversations sharing the prefix reach the same agent.
+	for _, chatID := range []string{"pico:p.seedtrial.aaa111", "pico:p.seedtrial.bbb222"} {
+		route := r.ResolveRoute(inbound(chatID))
+		if route.AgentID != "seedtrial" {
+			t.Errorf("chat %q: AgentID = %q, want 'seedtrial'", chatID, route.AgentID)
+		}
+		if route.MatchedBy != "dispatch.rule:project-seedtrial" {
+			t.Errorf("chat %q: MatchedBy = %q", chatID, route.MatchedBy)
+		}
+	}
+
+	// A conversation with no project prefix falls through to the default agent.
+	route := r.ResolveRoute(inbound("pico:9f2c4e"))
+	if route.AgentID != "main" {
+		t.Errorf("unprefixed chat: AgentID = %q, want 'main'", route.AgentID)
+	}
+	if route.MatchedBy != "default" {
+		t.Errorf("unprefixed chat: MatchedBy = %q, want 'default'", route.MatchedBy)
+	}
+
+	// A different project's prefix must not be captured by this rule.
+	route = r.ResolveRoute(inbound("pico:p.other.aaa111"))
+	if route.AgentID != "main" {
+		t.Errorf("other project: AgentID = %q, want 'main'", route.AgentID)
+	}
+}
