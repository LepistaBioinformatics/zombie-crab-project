+// publishHandledToolSummary delivers the one sentence a tool-delivered turn ends
+// with (handledToolResponseSummary), on the same path Finalize uses when the final
+// answer must reach the channel outside SendResponse.
+//
+// Gated exactly like that path: the SendResponse channels publish the turn's
+// finalContent through their caller, and this branch deliberately leaves it empty.
+func (al *AgentLoop) publishHandledToolSummary(ctx context.Context, ts *turnState) {
+	if ts == nil || ts.opts.SendResponse || !ts.opts.AllowInterimPicoPublish {
+		return
+	}
+	msg := outboundMessageForTurnWithOptions(ts, handledToolResponseSummary, outboundTurnMessageOptions{})
+	markFinalOutbound(&msg)
+	pubCtx, pubCancel := context.WithTimeout(ctx, 3*time.Second)
+	defer pubCancel()
+	if err := al.bus.PublishOutbound(pubCtx, msg); err != nil &&
+		!errors.Is(err, context.DeadlineExceeded) &&
+		!errors.Is(err, context.Canceled) &&
+		!errors.Is(err, bus.ErrBusClosed) {
+		logger.WarnCF("agent", "Failed to publish handled-tool summary", map[string]any{
+			"channel": ts.channel,
+			"chat_id": ts.chatID,
+			"error":   err.Error(),
+		})
+	}
+}
