diff --git a/pkg/agent/handled_tool_summary_test.go b/pkg/agent/handled_tool_summary_test.go
new file mode 100644
index 0000000..ed94eb8
--- /dev/null
+++ b/pkg/agent/handled_tool_summary_test.go
@@ -0,0 +1,95 @@
+// PicoClaw - Ultra-lightweight personal AI agent
+
+package agent
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/config"
+	"github.com/sipeed/picoclaw/pkg/media"
+)
+
+// recordingMediaChannel is fakeMediaChannel with a lock on the TEXT path, because
+// text is published through the manager's worker goroutine while the test reads it.
+type recordingMediaChannel struct {
+	fakeMediaChannel
+	mu    sync.Mutex
+	texts []string
+}
+
+func (r *recordingMediaChannel) Send(_ context.Context, msg bus.OutboundMessage) ([]string, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.texts = append(r.texts, msg.Content)
+	return nil, nil
+}
+
+func (r *recordingMediaChannel) sentTexts() []string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]string(nil), r.texts...)
+}
+
+// A turn whose output was delivered BY A TOOL ends without an LLM follow-up: the
+// handled-tool branch writes handledToolResponseSummary into the session and calls
+// setFinalContent(""), so nothing at all reaches the channel. The transcript and the
+// conversation then disagree — the sentence is in the history, and the member never
+// saw it — and any client that infers "the turn is over" from the messages it
+// receives never sees the turn end.
+//
+// The summary is already the turn's own account of itself. Publishing it costs
+// nothing and is what makes the delivery legible to a member and terminal to a
+// client.
+func TestHandledToolSummaryReachesTheChannel(t *testing.T) {
+	tmpDir := t.TempDir()
+	cfg := &config.Config{
+		Agents: config.AgentsConfig{
+			Defaults: config.AgentDefaults{
+				Workspace:         tmpDir,
+				ModelName:         "test-model",
+				MaxTokens:         4096,
+				MaxToolIterations: 10,
+			},
+		},
+	}
+
+	msgBus := bus.NewMessageBus()
+	al := NewAgentLoop(cfg, msgBus, &handledMediaProvider{})
+
+	store := media.NewFileMediaStore()
+	al.SetMediaStore(store)
+	channel := &recordingMediaChannel{fakeMediaChannel: fakeMediaChannel{fakeChannel: fakeChannel{id: "rid"}}}
+	al.SetChannelManager(newStartedTestChannelManager(t, msgBus, store, "telegram", channel))
+
+	imagePath := filepath.Join(tmpDir, "screen.png")
+	if err := os.WriteFile(imagePath, []byte("fake screenshot"), 0o644); err != nil {
+		t.Fatalf("WriteFile(imagePath) error = %v", err)
+	}
+	al.RegisterTool(&handledMediaTool{store: store, path: imagePath})
+
+	if _, err := al.processMessage(context.Background(), testInboundMessage(bus.InboundMessage{
+		Channel:  "telegram",
+		ChatID:   "chat1",
+		SenderID: "user1",
+		Content:  "take a screenshot of the screen and send it to me",
+	})); err != nil {
+		t.Fatalf("processMessage() error = %v", err)
+	}
+
+	// Published asynchronously through the manager's worker.
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if slices.Contains(channel.sentTexts(), handledToolResponseSummary) {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("the handled-tool summary never reached the channel; it sent %q", channel.sentTexts())
+}
