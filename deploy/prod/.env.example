# =============================================================================
# PRODUCTION deploy (no Traefik). Copy to .env at the repo root and run:
#   docker compose -f docker-compose.yaml -f docker-compose.prod.yaml up -d
# Official published images, mycelium in base/Postgres mode with explicit
# secrets + real SMTP; host ports still published -- front it with your own
# reverse proxy for TLS/domain ingress.
#
# After the FIRST up (base/Postgres has NO auto-migration): apply mycelium's
# adapters/diesel_postgres/sql/up.sql AND its sibling migrations/ scripts, at the
# tag MYCELIUM_IMAGE_TAG pins -- exact commands in the README's "Deploy modes".
# =============================================================================

# --- crab-shell-proxy -------------------------------------------------------
#CRAB_HOST_DATA_ROOT=/absolute/host/path/to/data
CRAB_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# --- Published ports (webapps + gateway) ------------------------------------
MYCELIUM_PORT=8080
CHAT_WEBAPP_PORT=3000
MYCELIUM_WEBAPP_PORT=8081

# --- Per-agent bearer tokens ------------------------------------------------
# One per agent routed in deploy/prod/config.base.toml. Every routed agent needs
# its token here: leaving one empty makes the gateway advertise the agent and
# inject an empty bearer, which fails at request time instead of at boot. To run
# prod without an agent, drop its `[[<agent>]]` blocks from config.base.toml AND
# mount a crab-shell-proxy config.yaml without it over
# /etc/crab-shell-proxy/config.yaml.
MYC_PICOCLAW_ALPHA_TOKEN=change-me-alpha
MYC_PICOCLAW_BETA_TOKEN=change-me-beta

# --- Per-instance LLM API keys ----------------------------------------------
PICOCLAW_ALPHA_API_KEY=sk-your-alpha-key
PICOCLAW_BETA_API_KEY=sk-your-beta-key

# --- chat-webapp Postgres ---------------------------------------------------
CHAT_WEBAPP_DB_USER=chatwebapp
CHAT_WEBAPP_DB_PASSWORD=change-me-db
CHAT_WEBAPP_DB_NAME=chatwebapp

# --- Production images (pulled, not built) ----------------------------------
# Same mycelium release standalone builds from source (MYCELIUM_GIT_REF in
# deploy/standalone/.env.example) -- keep them on one version.
MYCELIUM_IMAGE_TAG=9.0.0-rc.13
CRAB_SHELL_PROXY_TAG=latest
CHAT_WEBAPP_TAG=latest
# NOT PUBLISHED YET. harness-sphere ships binary releases only -- it has no image
# release workflow, and ghcr.io/lepistabioinformatics/harness-sphere 404s. Until
# that workflow exists, a prod deploy must either omit the harness-sphere service
# or build it from source; setting a tag here will not conjure an image.
HARNESS_SPHERE_TAG=latest

# ─── Knowledge graph (crab-shell-proxy's native MCP server) ───────────────────
# Signs the per-workspace bearer token a spawned agent presents back to the
# proxy's MCP endpoint.
#
# LEAVING THIS EMPTY DISABLES THE KNOWLEDGE GRAPH — the agent cannot authenticate
# to its own memory server, so it never records anything and the Map and Entities
# tabs stay empty. Nothing logs a warning about it, which is why it is spelled out
# here. Generate with: openssl rand -hex 32
CRAB_MCP_TOKEN_SECRET=
# Where the agent reaches that endpoint, on the compose network. Override only if
# you renamed the service or moved it off the default port.
CRAB_MCP_BASE_URL=http://crab-shell-proxy:8080

# ─── Observability (harness-sphere) ───────────────────────────────────────────
# Authorizes GET /v1/instances, the workspace inventory the watcher reads to
# attribute a container to its tenant/subscription/user.
#
# LEAVING THIS EMPTY MEANS THE ROUTE IS NOT REGISTERED AT ALL -- 404, not 401.
# The watcher still reports the host, itself and the service probes; it just
# cannot see per-tenant instances. Safe default on purpose: this endpoint
# discloses the deployment's whole tenant topology.
#
# Do NOT reuse an agent token. The mycelium profile header is decoded and never
# verified, so an agent's token is what stops a caller on the compose network
# from asserting any account it likes -- it gates chatting AS ANY MEMBER.
# Generate with: openssl rand -hex 32
CRAB_TELEMETRY_TOKEN=
# "stdout" (the default) proves the pipeline with no backend; set "otlp" once a
# collector exists.
HARNESS_SPHERE_EXPORTER=stdout

# ─── Branding / white-label ───────────────────────────────────────────────────
# 1/true -> the webapp starts at the sign-in screen: `/` redirects to /signin and
# the pre-auth landing page (and the Lepista brand bar it embeds) is never served.
# Leave empty to keep the landing page. The app name and logos are set in-app, on
# the admin screen's Branding tab.
START_AT_SIGNIN=

# --- Mycelium's own Postgres ------------------------------------------------
MYC_DB_USER=mycelium
MYC_DB_PASSWORD=change-me-myc-db
MYC_DB_NAME=mycelium

# --- Mycelium base-mode secrets -- openssl rand -hex 32 each -----------------
MYC_BASE_TOKEN_SECRET=change-me-openssl-rand-hex-32
MYC_BASE_HMAC_SECRET=change-me-openssl-rand-hex-32
MYC_BASE_JWT_SECRET=change-me-openssl-rand-hex-32

# --- Gmail SMTP (magic-link signin) -----------------------------------------
# Port fixed at 465 in config.base.toml (not an env var). MYC_SMTP_PASSWORD is a
# Gmail APP PASSWORD (2FA); MYC_SMTP_USERNAME must equal config.base.toml noreplyEmail.
MYC_SMTP_HOST=smtp.gmail.com
MYC_SMTP_USERNAME=your-account@gmail.com
MYC_SMTP_PASSWORD=your-16-char-app-password

# --- (optional) mycelium staff bootstrap ------------------------------------
# openssl rand -hex 32; empty keeps the bootstrap endpoints 404'd.
MYC_STANDALONE_BOOTSTRAP_SECRET=
