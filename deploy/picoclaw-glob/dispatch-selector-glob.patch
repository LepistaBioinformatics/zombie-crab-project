+// selectorMatches reports whether one dispatch selector accepts the inbound
+// value. An empty pattern is an unconstrained selector and matches anything.
+//
+// A pattern containing no "*" is compared exactly, which is what every existing
+// configuration relies on. A pattern containing "*" is matched as a glob, so one
+// rule can cover a family of chats instead of naming each one. This matters for
+// deployments that create chats dynamically: without it, routing a group of
+// conversations to an agent needs one rule per conversation.
+//
+// "*" is the only metacharacter. "?", "[", "]" and "\" are ordinary characters.
+// That is a deliberate restriction rather than an oversight:
+//
+//   - filepath.Match would be the obvious reach, but its "*" does not cross the
+//     path separator, and chat identifiers on several channels contain "/".
+//   - A syntax with character classes has malformed patterns, and every way of
+//     handling one is bad here — treating it as no-match silently disables a
+//     rule, treating it as a match silently turns it into a catch-all that
+//     reroutes conversations to the wrong agent. With "*" alone, no pattern can
+//     be malformed.
+//
+// Both sides arrive lowercased (normalizeDispatchSelector and buildDispatchView),
+// so matching stays case-insensitive without extra work here.
+func selectorMatches(pattern, value string) bool {
+	if pattern == "" {
+		return true
+	}
+	if !strings.Contains(pattern, "*") {
+		return pattern == value
+	}
+	return globMatch(pattern, value)
+}
+
+// globMatch matches value against a pattern in which "*" stands for any sequence
+// of characters, including the empty one.
+//
+// Consuming left to right needs no backtracking: with "*" as the only
+// metacharacter, taking the leftmost occurrence of each literal segment is
+// always safe, because anything skipped can be absorbed by the "*" that precedes
+// it.
+func globMatch(pattern, value string) bool {
+	segments := strings.Split(pattern, "*")
+	if len(segments) == 1 {
+		return pattern == value
+	}
+
+	// The text before the first "*" must be a prefix.
+	if first := segments[0]; first != "" {
+		if !strings.HasPrefix(value, first) {
+			return false
+		}
+		value = value[len(first):]
+	}
+
+	// The text after the last "*" must be a suffix of what is left, which is also
+	// what stops a prefix and a suffix from claiming the same characters.
+	if last := segments[len(segments)-1]; last != "" {
+		if !strings.HasSuffix(value, last) {
+			return false
+		}
+		value = value[:len(value)-len(last)]
+	}
+
+	// Every remaining segment must appear in order, without overlapping.
+	for _, segment := range segments[1 : len(segments)-1] {
+		if segment == "" {
+			continue
+		}
+		idx := strings.Index(value, segment)
+		if idx < 0 {
+			return false
+		}
+		value = value[idx+len(segment):]
+	}
+	return true
+}
