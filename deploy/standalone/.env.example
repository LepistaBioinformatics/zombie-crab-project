# =============================================================================
# STANDALONE deploy -- local default. Copy to .env at the repo root and run:
#   docker compose up -d
# mycelium runs standalone (built from source, auto-generated core secrets);
# every service is built locally; host ports are published.
# =============================================================================

# NO IMAGE TAGS HERE, and that is not an omission. Standalone BUILDS every service
# from the local checkout (`build:` in docker-compose.yaml, not `image:`), so
# CRAB_SHELL_PROXY_TAG / CHAT_WEBAPP_TAG -- which the prod and dokploy modes pin --
# do nothing in this mode. What you get is whatever is in your working tree, which is
# the point of testing here first.

# --- crab-shell-proxy -------------------------------------------------------
# Absolute HOST path of the data root; defaults to ${PWD}/data when compose runs
# from the project root. Set explicitly if you run from elsewhere.
#CRAB_HOST_DATA_ROOT=/absolute/path/to/zombie-crab-project/data
# Shared secret for the mycelium subscriptionAccount.created webhook. openssl rand -hex 32
CRAB_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# --- Mycelium gateway (built from source in standalone) ---------------------
MYCELIUM_PORT=8080
# Pinned upstream commit built by fungi/mycelium/Dockerfile.standalone: the
# commit tagged 9.0.0-rc.13. Same release the prod/dokploy modes pull by tag
# (MYCELIUM_IMAGE_TAG=9.0.0-rc.13) -- move all of them together.
MYCELIUM_GIT_REF=9298ecb44a69ced91cb2d7d3356a716aedca858b

# --- Per-agent bearer tokens (mycelium injects, the proxy validates) --------
# openssl rand -hex 32 each
MYC_PICOCLAW_ALPHA_TOKEN=change-me-alpha
MYC_PICOCLAW_BETA_TOKEN=change-me-beta

# --- Per-instance LLM API keys ----------------------------------------------
PICOCLAW_ALPHA_API_KEY=sk-your-alpha-key
PICOCLAW_BETA_API_KEY=sk-your-beta-key

# --- mycelium-gateway staff bootstrap ---------------------------------------
# openssl rand -hex 32; leave empty to keep the bootstrap endpoints 404'd.
MYC_STANDALONE_BOOTSTRAP_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- Published ports (webapps) ----------------------------------------------
CHAT_WEBAPP_PORT=3000

# ─── Knowledge graph (crab-shell-proxy's native MCP server) ───────────────────
# Signs the per-workspace bearer token a spawned agent presents back to the
# proxy's MCP endpoint.
#
# LEAVING THIS EMPTY DISABLES THE KNOWLEDGE GRAPH — the agent cannot authenticate
# to its own memory server, so it never records anything and the Map and Entities
# tabs stay empty. Nothing logs a warning about it, which is why it is spelled out
# here. Generate with: openssl rand -hex 32
CRAB_MCP_TOKEN_SECRET=
# Where the agent reaches that endpoint, on the compose network. Override only if
# you renamed the service or moved it off the default port.
CRAB_MCP_BASE_URL=http://crab-shell-proxy:8080

# ─── Branding / white-label ───────────────────────────────────────────────────
# 1/true -> the webapp starts at the sign-in screen: `/` redirects to /signin and
# the pre-auth landing page (and the Lepista brand bar it embeds) is never served.
# Leave empty to keep the landing page. The app name and logos are set in-app, on
# the admin screen's Branding tab.
START_AT_SIGNIN=
MYCELIUM_WEBAPP_PORT=8081

# --- chat-webapp Postgres (conversation metadata) ---------------------------
CHAT_WEBAPP_DB_USER=chatwebapp
CHAT_WEBAPP_DB_PASSWORD=change-me-db
CHAT_WEBAPP_DB_NAME=chatwebapp

# --- picoclaw image the proxy spawns ----------------------------------------
# This file used to state that the spawned image is "NOT an env var: it comes from
# `picoclawImage` in crab-shell-proxy's config.yaml". That is wrong -- see
# docker-compose.yaml, which passes CRAB_PICOCLAW_IMAGE into the proxy's environment
# with this same default. Left commented because the default is the one you want:
# the locally built, patched image (agent-projects depends on its dispatch-selector
# patch). Point it at docker.io/sipeed/picoclaw:latest to run stock picoclaw --
# projects stop working, nothing else changes.
#CRAB_PICOCLAW_IMAGE=zombie-crab/picoclaw:0.3.1-glob
