+func TestSelectorMatches(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		value   string
+		want    bool
+	}{
+		// An empty selector is unconstrained.
+		{"empty pattern matches anything", "", "direct:pico:abc", true},
+		{"empty pattern matches empty value", "", "", true},
+
+		// No "*" keeps the pre-existing exact comparison.
+		{"literal match", "group:-100123", "group:-100123", true},
+		{"literal mismatch", "group:-100123", "group:-100124", false},
+		{"literal is not a prefix match", "group:-100", "group:-100123", false},
+
+		{"bare star matches anything", "*", "direct:pico:abc", true},
+		{"bare star matches empty value", "*", "", true},
+		{"prefix", "direct:pico:p.demo.*", "direct:pico:p.demo.a1b2", true},
+		{"prefix rejects other prefixes", "direct:pico:p.demo.*", "direct:pico:p.other.a1b2", false},
+		{"prefix matches empty remainder", "direct:pico:p.demo.*", "direct:pico:p.demo.", true},
+		{"suffix", "*.internal", "team.internal", true},
+		{"suffix mismatch", "*.internal", "team.external", false},
+		{"middle", "group:*:staging", "group:eu-west:staging", true},
+		{"middle mismatch", "group:*:staging", "group:eu-west:prod", false},
+		{"several stars", "a*b*c", "axxbyyc", true},
+		{"several stars out of order", "a*b*c", "axxcyyb", false},
+		{"star does not require characters", "ab*", "ab", true},
+		{"prefix and suffix may not overlap", "aa*aa", "aaa", false},
+		{"prefix and suffix exactly adjacent", "aa*aa", "aaaa", true},
+
+		// "*" is the ONLY metacharacter. Everything else is literal, which is what
+		// makes malformed patterns impossible.
+		{"question mark is literal", "a?c", "a?c", true},
+		{"question mark does not match one char", "a?c", "abc", false},
+		{"bracket is literal", "chat[1]", "chat[1]", true},
+		{"unbalanced bracket is literal, not an error", "chat[1", "chat[1", true},
+		// A backslash is an ordinary character: it does not escape the "*", which
+		// still globs, and it is itself required to be present in the value.
+		{"backslash does not escape the star", `a\*b`, `a\xyzb`, true},
+		{"backslash itself must match", `a\*b`, `axyzb`, false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := selectorMatches(tt.pattern, tt.value); got != tt.want {
+				t.Errorf("selectorMatches(%q, %q) = %v, want %v",
+					tt.pattern, tt.value, got, tt.want)
+			}
+		})
+	}
+}
